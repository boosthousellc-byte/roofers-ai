# ── Twilio (SMS outreach + funnel SMS automation) ────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Email / SMTP (funnel automations) ────────────────────────────────────────
# Gmail example: use an App Password (not your regular password)
#   https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# Displayed as the sender name in emails
FROM_EMAIL=you@gmail.com
FROM_NAME=Derek Lee | RoofersAI

# Internal alert destination (your inbox for new-lead notifications)
OWNER_EMAIL=derek@yourdomain.com

# ── Funnel URLs ───────────────────────────────────────────────────────────────
AUDIT_LANDING_URL=https://roofers-ai.netlify.app/funnel/audit-landing.html
BOOKING_URL=https://calendly.com/derek-roofers-ai/30min

# ── Flask API (for form -> backend integration) ──────────────────────────────
# Set this on your deployed frontend to point to your Flask server
# Example: FUNNEL_API_URL=https://your-api.digitalocean.app
# Leave blank to run in localStorage-only mode
FUNNEL_API_URL=
